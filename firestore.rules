rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Hardened Helpers
    // ---------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'jhonatanparedes563@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol in ['admin', 'receptor'] &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.estado == 'ACTIVO'
          )
        )
      );
    }

    function isOptionalBoundedList(data, key, maxLen) {
      return !(key in data) || (data[key] is list && data[key].size() <= maxLen);
    }

    function isOptionalBoundedMapList(data, key, maxLen) {
      return !(key in data) || (
        data[key] is list &&
        data[key].size() <= maxLen &&
        (data[key].size() == 0 || data[key][0] is map)
      );
    }

    function isOptionalBoundedString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    // ---------------------------------------------------------
    // Entity Validation Blueprints (Anti-Update-Gap)
    // ---------------------------------------------------------
    function isValidRequerimiento(data) {
      return data.keys().hasAll([
          'id', 'numeroRequerimiento', 'fecha', 'area', 'fundo',
          'movimiento', 'horaRecojo', 'horaSalida', 'observaciones',
          'usuario', 'userId', 'fechaRegistro', 'totalPersonas', 'estado'
        ]) &&
        data.keys().hasOnly([
          'id', 'numeroRequerimiento', 'fecha', 'area', 'fundo',
          'cultivo', 'parcelas', 'movimiento', 'horaRecojo', 'horaSalida',
          'horaRecojoNorte', 'horaRecojoSur', 'observaciones', 'usuario',
          'userId', 'userUsername', 'userRole', 'fechaRegistro', 'updatedAt',
          'totalPersonas', 'estado', 'fechaAnulacion', 'usuarioAnulacion',
          'motivoAnulacion', 'historialTrazabilidad'
        ]) &&
        isValidId(data.id) &&
        data.numeroRequerimiento is string && data.numeroRequerimiento.size() >= 5 && data.numeroRequerimiento.size() <= 32 && data.numeroRequerimiento.matches('^REQ-[0-9]+$') &&
        data.fecha is string && data.fecha.size() == 10 && data.fecha.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.area is string && data.area.size() >= 1 && data.area.size() <= 80 &&
        data.fundo is string && data.fundo.size() >= 1 && data.fundo.size() <= 80 &&
        isOptionalBoundedString(data, 'cultivo', 60) &&
        isOptionalBoundedList(data, 'parcelas', 50) &&
        (!('parcelas' in data) || data.parcelas.size() == 0 || data.parcelas[0] is string) &&
        data.movimiento in ['INGRESO', 'SALIDA', 'Programa personal por tarea'] &&
        data.horaRecojo is string && data.horaRecojo.size() >= 3 && data.horaRecojo.size() <= 40 &&
        data.horaSalida is string && data.horaSalida.size() >= 3 && data.horaSalida.size() <= 40 &&
        isOptionalBoundedString(data, 'horaRecojoNorte', 16) &&
        isOptionalBoundedString(data, 'horaRecojoSur', 16) &&
        data.observaciones is string && data.observaciones.size() <= 500 &&
        data.usuario is string && data.usuario.size() >= 1 && data.usuario.size() <= 120 &&
        isValidId(data.userId) &&
        isOptionalBoundedString(data, 'userUsername', 64) &&
        (!('userRole' in data) || data.userRole in ['usuario', 'admin', 'receptor']) &&
        data.fechaRegistro is string && data.fechaRegistro.size() >= 10 && data.fechaRegistro.size() <= 40 &&
        isOptionalBoundedString(data, 'updatedAt', 40) &&
        data.totalPersonas is number && data.totalPersonas >= 1 && data.totalPersonas <= 5000 &&
        data.estado in ['PENDIENTE', 'EN REVISIÓN', 'APROBADO', 'RECHAZADO', 'ATENDIDO', 'ANULADO'] &&
        isOptionalBoundedString(data, 'fechaAnulacion', 40) &&
        isOptionalBoundedString(data, 'usuarioAnulacion', 120) &&
        isOptionalBoundedString(data, 'motivoAnulacion', 300) &&
        isOptionalBoundedMapList(data, 'historialTrazabilidad', 50);
    }

    function isValidDetalle(data) {
      return data.keys().hasAll([
          'id', 'requerimientoId', 'numeroRequerimiento', 'userId', 'comedor', 'paradero', 'cantidad'
        ]) &&
        data.keys().hasOnly([
          'id', 'requerimientoId', 'numeroRequerimiento', 'userId', 'comedor',
          'parcela', 'paradero', 'zona', 'cultivo', 'cantidad'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.requerimientoId) &&
        data.numeroRequerimiento is string && data.numeroRequerimiento.size() >= 5 && data.numeroRequerimiento.size() <= 32 && data.numeroRequerimiento.matches('^REQ-[0-9]+$') &&
        isValidId(data.userId) &&
        data.comedor is string && data.comedor.size() >= 1 && data.comedor.size() <= 60 &&
        isOptionalBoundedString(data, 'parcela', 60) &&
        data.paradero is string && data.paradero.size() >= 1 && data.paradero.size() <= 120 &&
        (!('zona' in data) || data.zona in ['NORTE', 'SUR']) &&
        isOptionalBoundedString(data, 'cultivo', 60) &&
        data.cantidad is number && data.cantidad >= 1 && data.cantidad <= 500;
    }

    function isValidAppUser(data) {
      return data.keys().hasAll([
          'id', 'nombre', 'usuario', 'rol', 'area', 'fundo', 'estado'
        ]) &&
        data.keys().hasOnly([
          'id', 'nombre', 'usuario', 'email', 'rol', 'area', 'fundo', 'cultivo',
          'estado', 'fechaCreacion', 'ultimoAcceso', 'terminosAceptados',
          'fechaAceptacionTerminos', 'versionTerminosAceptada'
        ]) &&
        isValidId(data.id) &&
        data.nombre is string && data.nombre.size() >= 2 && data.nombre.size() <= 120 &&
        data.usuario is string && data.usuario.size() >= 3 && data.usuario.size() <= 32 && data.usuario.matches('^[a-zA-Z0-9._\\-]+$') &&
        isOptionalBoundedString(data, 'email', 120) &&
        data.rol in ['usuario', 'admin', 'receptor'] &&
        data.area is string && data.area.size() >= 1 && data.area.size() <= 80 &&
        data.fundo is string && data.fundo.size() >= 1 && data.fundo.size() <= 80 &&
        isOptionalBoundedString(data, 'cultivo', 60) &&
        data.estado in ['ACTIVO', 'INACTIVO'] &&
        isOptionalBoundedString(data, 'fechaCreacion', 40) &&
        isOptionalBoundedString(data, 'ultimoAcceso', 40) &&
        (!('terminosAceptados' in data) || data.terminosAceptados is bool) &&
        isOptionalBoundedString(data, 'fechaAceptacionTerminos', 40) &&
        isOptionalBoundedString(data, 'versionTerminosAceptada', 40);
    }

    function isValidSystemMetadata(data) {
      return data.keys().hasAll(['lastUpdated']) &&
        data.keys().hasOnly([
          'id', 'revision', 'lastUpdated', 'areas', 'fundos', 'zonas', 'paraderos', 'comedores', 'unidadesBus'
        ]) &&
        isOptionalBoundedString(data, 'id', 64) &&
        (!('revision' in data) || (data.revision is number && data.revision >= 0)) &&
        data.lastUpdated is string && data.lastUpdated.size() >= 10 && data.lastUpdated.size() <= 40 &&
        isOptionalBoundedMapList(data, 'areas', 200) &&
        isOptionalBoundedMapList(data, 'fundos', 200) &&
        isOptionalBoundedMapList(data, 'zonas', 200) &&
        isOptionalBoundedMapList(data, 'paraderos', 500) &&
        isOptionalBoundedMapList(data, 'comedores', 200) &&
        isOptionalBoundedMapList(data, 'unidadesBus', 100);
    }

    // ---------------------------------------------------------
    // Admins allowlist collection (managed strictly by Bootstrapped Admin)
    // ---------------------------------------------------------
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if isBootstrappedAdmin() && isValidId(adminId);
    }

    // ---------------------------------------------------------
    // Requerimientos Collection
    // ---------------------------------------------------------
    match /requerimientos/{reqId} {
      allow get: if isSignedIn() && isValidId(reqId) && (
        existing().userId == request.auth.uid || isAdmin()
      );

      allow list: if isBootstrappedAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );

      allow create: if isSignedIn() &&
        isValidId(reqId) &&
        isValidRequerimiento(incoming()) &&
        incoming().id == reqId &&
        incoming().userId == request.auth.uid &&
        incoming().estado == 'PENDIENTE';

      allow update: if isSignedIn() &&
        isValidId(reqId) &&
        isValidRequerimiento(incoming()) &&
        incoming().id == existing().id &&
        incoming().numeroRequerimiento == existing().numeroRequerimiento &&
        incoming().userId == existing().userId &&
        incoming().fechaRegistro == existing().fechaRegistro &&
        (
          isAdmin() || (
            existing().userId == request.auth.uid &&
            existing().estado == 'PENDIENTE' &&
            incoming().estado == 'ANULADO' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'estado', 'updatedAt', 'fechaAnulacion', 'usuarioAnulacion', 'motivoAnulacion', 'historialTrazabilidad'
            ])
          )
        );

      allow delete: if isAdmin() && isValidId(reqId);
    }

    // ---------------------------------------------------------
    // Detalles Collection (Relational link to /requerimientos)
    // ---------------------------------------------------------
    match /detalles/{detId} {
      allow get: if isSignedIn() && isValidId(detId) && (
        existing().userId == request.auth.uid || isAdmin()
      );

      allow list: if isBootstrappedAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );

      allow create: if isSignedIn() &&
        isValidId(detId) &&
        isValidDetalle(incoming()) &&
        incoming().id == detId &&
        (incoming().userId == request.auth.uid || isAdmin()) &&
        existsAfter(/databases/$(database)/documents/requerimientos/$(incoming().requerimientoId)) &&
        getAfter(/databases/$(database)/documents/requerimientos/$(incoming().requerimientoId)).data.userId == incoming().userId;

      allow update: if isSignedIn() &&
        isValidId(detId) &&
        isValidDetalle(incoming()) &&
        incoming().id == existing().id &&
        incoming().requerimientoId == existing().requerimientoId &&
        incoming().userId == existing().userId &&
        isAdmin();

      allow delete: if isAdmin() && isValidId(detId);
    }

    // ---------------------------------------------------------
    // Users Collection (PII Isolated, No Credentials Stored)
    // ---------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId || isAdmin()
      );

      allow list: if isBootstrappedAdmin() || (
        isSignedIn() && resource.data.id == request.auth.uid
      );

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isValidAppUser(incoming()) &&
        incoming().id == userId &&
        (
          isAdmin() || (
            request.auth.uid == userId &&
            incoming().rol == 'usuario' &&
            incoming().estado == 'ACTIVO'
          )
        );

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidAppUser(incoming()) &&
        incoming().id == existing().id &&
        (
          isAdmin() || (
            request.auth.uid == userId &&
            incoming().rol == existing().rol &&
            incoming().estado == existing().estado &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'ultimoAcceso', 'terminosAceptados', 'fechaAceptacionTerminos', 'versionTerminosAceptada'
            ])
          )
        );

      allow delete: if isAdmin() && isValidId(userId) && userId != request.auth.uid;
    }

    // ---------------------------------------------------------
    // System Metadata Collection (Master Catalogs)
    // ---------------------------------------------------------
    match /system_metadata/{metaId} {
      allow get: if isSignedIn() && isValidId(metaId);
      allow list: if false;
      allow create, update: if isAdmin() && isValidId(metaId) && isValidSystemMetadata(incoming());
      allow delete: if isAdmin() && isValidId(metaId);
    }
  }
}
